import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

# Set visual style
sns.set_theme(style="whitegrid")
np.random.seed(42)

# Simulate Dataset
n_samples = 1000
data = {
    'distance_miles': np.random.uniform(5, 150, n_samples),
    'cargo_weight_kg': np.random.uniform(200, 3000, n_samples),
    'traffic_delay_mins': np.random.exponential(15, n_samples),
    'vehicle_type': np.random.choice(['Van', 'Light Truck', 'Heavy Truck'], n_samples)
}
df = pd.DataFrame(data)

# Derive dependent variables
df['actual_time_hrs'] = (df['distance_miles'] / 45) + (df['traffic_delay_mins'] / 60) + np.random.normal(0, 0.2, n_samples)
df['fuel_cost_usd'] = 20 + (df['distance_miles'] * 0.45) + (df['cargo_weight_kg'] * 0.005) + np.random.normal(0, 5, n_samples)

# 1. Statistical Summary
print("--- Summary Statistics ---")
print(df[['distance_miles', 'cargo_weight_kg', 'actual_time_hrs', 'fuel_cost_usd']].describe())

# 2. Correlation Matrix
plt.figure(figsize=(8, 6))
numeric_df = df[['distance_miles', 'cargo_weight_kg', 'traffic_delay_mins', 'actual_time_hrs', 'fuel_cost_usd']]
sns.heatmap(numeric_df.corr(), annot=True, cmap='coolwarm', fmt=".2f", linewidths=0.5)
plt.title("Logistics Metrics Correlation Heatmap")
plt.tight_layout()
plt.savefig("correlation_heatmap.png")
plt.close()

# 3. Scatter Plot: Fuel Cost vs Distance by Vehicle Type
plt.figure(figsize=(10, 6))
sns.scatterplot(data=df, x='distance_miles', y='fuel_cost_usd', hue='vehicle_type', alpha=0.7, palette='Set2')
plt.title("Fuel Cost vs. Transit Distance by Vehicle Type")
plt.xlabel("Distance (Miles)")
plt.ylabel("Fuel Cost ($ USD)")
plt.tight_layout()
plt.savefig("fuel_vs_distance.png")
plt.close()

# 4. Box Plot: Traffic Delays by Vehicle Type
plt.figure(figsize=(8, 5))
sns.boxplot(data=df, x='vehicle_type', y='traffic_delay_mins', palette='Pastel1')
plt.title("Traffic Delay Distribution Across Vehicle Types")
plt.xlabel("Vehicle Type")
plt.ylabel("Traffic Delay (Minutes)")
plt.tight_layout()
plt.savefig("delays_boxplot.png")
plt.close()

print("Visualizations generated and saved successfully!")
